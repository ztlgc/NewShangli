# Local assistant state and downloaded design caches.
# Keep the project's reusable skills in version control.
/.claude/
/.stitch/
/.codex/*
!/.codex/skills/
# Keep shared VS Code tasks and launch settings; ignore machine-local state only.
/.vscode/*.local.json

# Flutter / Dart build outputs and dependency caches
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.build/
.buildlog/
.swiftpm/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
/migrate_working_dir/
app.*.symbols
app.*.map.json
# pubspec.lock, .metadata and generated Drift source (*.g.dart) are intentional.

# Android build outputs and local SDK/signing configuration
.gradle/
.cxx/
.externalNativeBuild/
*.class
/android/captures/
/android/local.properties
/android/key.properties
/android/app/debug/
/android/app/profile/
/android/app/release/
*.jks
*.keystore
*.apk
*.aab

# Local reports, exports, temporary work and runtime data
/output/
/artifacts/
/tmp/
/temp/
/backups/
/build_size_report.txt
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
# Deliberate test fixtures can be checked in here.
!test/fixtures/**
!integration_test/fixtures/**

# Local credentials and environment overrides; keep example templates
.env
.env.*
!.env.example
!.env.sample
!.env.template
/supabase.local.json
/supabase/.temp/
/supabase/.branches/